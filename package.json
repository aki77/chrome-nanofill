{
  "name": "chrome-nanofill",
  "version": "0.1.0",
  "private": true,
  "description": "Fill the focused form field with plausible dummy data generated by Chrome's built-in Gemini Nano.",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/dom-chromium-ai": "^0.0.7",
    "@types/node": "^25.9.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
